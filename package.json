{
  "name": "amawp-tackly",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Tackly by AMAWP: free Pinterest pin designer and scheduler",
  "scripts": {
    "dev": "vite --config frontend/vite.config.js",
    "build": "vite build --config frontend/vite.config.js",
    "preview": "vite preview --config frontend/vite.config.js",
    "test": "vitest run",
    "worker:dev": "wrangler dev --config worker/wrangler.toml --local"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.9.4",
    "preact": "10.25.4",
    "vite": "6.0.11",
    "vitest": "3.0.4",
    "wrangler": "3.107.3"
  }
}
